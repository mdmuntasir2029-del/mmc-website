VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — this deployment's own canonical domain, used only for links
# that go into emails (e.g. the password-reset code). Falls back to the
# real site's domain if unset; set this explicitly on any OTHER
# deployment (e.g. the Fest Hub contest deployment) so its emails point
# at itself instead.
VITE_SITE_URL=https://your-deployment-domain.example
